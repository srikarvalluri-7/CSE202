    // store

    //array of integer
    int arrint[5];
    arrint[0] = 1;
    arrint[4] = 5;
    for(int i=0;i<5;i++){
        cout << arrint[i];
    }
    //if no element is declared by default it will take 
    //dafault value according data type
    // int - 0
    //float - 0.0
    // bool- false

    // insertion 
    //1. at start
    //    for insertion of an element at start of an array we use shifting.
    
    int main(){
        int arr[] = {2,3,6,8,10};
        int n = sizeof(arr)/sizeof(arr[0]);
        int val = 1; //insert at start
        for(int i=n;i>0;i--){
            arr[i]=arr[i-1];
            
        }
        arr[0]=val;
        n++;
        for(int i=0;i<n;i++){
            cout<<arr[i]<<" ";
        }
        
    

    //2. at end
    
    int main(){
        int arr[] = {2,3,6,8,10};
        int n = sizeof(arr)/sizeof(arr[0]);
        int val = 1; //insert at start

        n++;
        arr[n-1]=val;
        for(int i=0;i<n;i++){
            cout<<arr[i]<<" ";
        }
    // insertion at a certain position

    int main(){
        int arr[] = {2,3,6,8,10};
        int n = sizeof(arr)/sizeof(arr[0]);
        int val = 1; 
        int pos = 3;
        for(int i=n;i>pos;i--){
            arr[i]=arr[i-1];
        }
        arr[pos] = val;
        n++;
        for(int i=0;i<n;i++){
            cout<<arr[i]<<" ";
        }
        
    }


}


// checking prime number

#include <iostream>
using namespace std;
bool isprime(int n){
    
    for(int i=2;i<n;i++){
        if(n%i==0){
            return false;
        }
        break;
    }
    return true;
}
int main(){
    int n;
    cin>>n;
    if(isprime(n)){
        cout<<"Prime";
    }
    else{
        cout<<"not prime";
    }
}


//finding palindrome or not
#include <iostream>
using namespace std;
bool ispalindrome(int n){
    int temp = n;
    int rev=0,d;
    for(;n>0;n/=10){
        d = n%10;
        rev = rev*10 + d;
    }
    if(temp==rev){
        return true;
    }
    else{
        return false;
    }
}
int main(){
    int n;
    cin>>n;
    if(ispalindrome(n)){
        cout<<"Palindrome";
    }
    else{
        cout<<"Not a Palindrome";
    }
}


//sum of first and last digit of the numbed.
#include <iostream>
using namespace std;
int reverse(int n){
    int temp = n;
    int rev=0,d;
    for(;n>0;n/=10){
        d = n%10;
        rev = rev*10 + d;
    }
    return rev;
}
int main(){
    int n;
    cin>>n;
    int l = n%10;
    int f = reverse(n)%10;
    int sum = f+l;
    cout<<sum;
}

//product of  digits of the number.
#include <iostream>
using namespace std;
int product(int n){
    int d;
    int product = 1;
    for(;n>0;n/=10){
        d = n%10;
        product*=d;
    }
    return product;
}
int main(){
    int n;
    cin>>n;
    cout<<product(n);
}

