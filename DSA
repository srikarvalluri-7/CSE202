#include<iostream>
using namespace std;
void main(){
    //creation of an array
    //data type 
    //int: every element will be integer
    //char: every element will be char, also known as string
    //float: every elementr will be float

    //name of array
    //size: total capacity of array
    // array is fixed in size, only limited element we can enter
    // store

    //array of integer
    int arrint[5];
    arrint[0] = 1;
    arrint[4] = 5;
    for(int i=0;i<5;i++){
        cout << arrint[i];
    }
    //if no element is declared by default it will take 
    //dafault value according data type
    // int - 0
    //float - 0.0
    // bool- false

    // insertion 
    //1. at start
    //    for insertion of an element at start of an array we use shifting.
    
    int main(){
        int arr[] = {2,3,6,8,10};
        int n = sizeof(arr)/sizeof(arr[0]);
        int val = 1; //insert at start
        for(int i=n;i>0;i--){
            arr[i]=arr[i-1];
            
        }
        arr[0]=val;
        n++;
        for(int i=0;i<n;i++){
            cout<<arr[i]<<" ";
        }
        
    

    //2. at end
    
    int main(){
        int arr[] = {2,3,6,8,10};
        int n = sizeof(arr)/sizeof(arr[0]);
        int val = 1; //insert at start

        n++;
        arr[n-1]=val;
        for(int i=0;i<n;i++){
            cout<<arr[i]<<" ";
        }
    


}
